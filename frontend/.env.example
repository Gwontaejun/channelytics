BACKEND_API_URL=http://127.0.0.1:8000

# 배포된 서비스의 공개 주소입니다. canonical URL, sitemap, robots, 공유 이미지 주소에 사용됩니다.
SITE_URL=https://example.com

# Google Search Console에서 발급받은 HTML 태그의 content 값입니다. 선택 사항입니다.
GOOGLE_SITE_VERIFICATION=

# 개인정보처리방침과 이용약관에 표시할 운영 정보입니다.
LEGAL_OPERATOR_NAME=Channelytics 운영자
LEGAL_PRIVACY_OFFICER_NAME=개인정보 보호업무 담당자 이름
LEGAL_CONTACT_EMAIL=contact@example.com
# 이메일 대신 HTTPS 문의 페이지를 사용할 때만 설정합니다.
LEGAL_CONTACT_URL=https://example.com/contact
LEGAL_EFFECTIVE_DATE=2026년 9월 7일
LEGAL_HOSTING_PROVIDER=배포에 사용하는 호스팅 제공자
LEGAL_HOSTING_COUNTRY=호스팅 제공자가 데이터를 처리하는 국가
LEGAL_HOSTING_LOG_RETENTION_DAYS=30

# Google AdSense에서 발급받은 공개 식별자입니다. 설정하지 않으면 광고를 렌더링하지 않습니다.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_LEFT_RAIL_SLOT_ID=0000000000
